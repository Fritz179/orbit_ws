server {
    listen 80;
    server_name _;

    # Root -> your live stream
    location = / {
        return 302 /pose/;
    }

    # Proxy everything else to MediaMTX (WebRTC UI, assets, etc.)
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
    }
}