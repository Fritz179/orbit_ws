[Unit]
Description=LED Strip Cycle Service
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=orbit
WorkingDirectory=/home/orbit
ExecStart=/usr/bin/python3 /home/orbit/orbit/led.py
Restart=always
RestartSec=3

# Optional: give SPI access if not using root
AmbientCapabilities=CAP_SYS_RAWIO
# For SPI without sudo, ensure 'orbit' is in spi group:
# sudo usermod -aG spi orbit

[Install]
WantedBy=multi-user.target
